[Unit]
Description=Scheduled export of the Incus backup project on Omega
# Просим запустить Incus и монтирование архива перед экспортом.
# После ошибки монтирования экспортёр сам проверит путь и опубликует статус.
Wants=incus.service storage-incus\x2dbackup.mount
After=incus.service incus-startup.service storage-incus\x2dbackup.mount

[Service]
Type=oneshot
ExecStart=/usr/local/bin/incus-backup.sh --scheduled
# Здесь сохраняется отметка начала недельной попытки между загрузками.
StateDirectory=bt-incus-backup
StateDirectoryMode=0700
# Предварительный потолок для полного прохода. Уточняем по реальному замеру.
TimeoutStartSec=12h
TimeoutStopSec=30s
KillMode=control-group
